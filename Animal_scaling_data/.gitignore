# Animal_scaling_data .gitignore

## Raw downloaded data files (large; re-downloadable)
data/raw/
providers/*/data/raw/*.csv
providers/*/data/raw/*.xlsx
providers/*/data/raw/*.zip

## Compiled outputs (regenerated by scripts)
data/compiled/
output/*.csv
output/*.txt

## Keep placeholder markers
!data/raw/.gitkeep
!data/compiled/.gitkeep
!output/.gitkeep

## R session artifacts
.Rhistory
.RData
.Rproj.user/
*.Rproj

## macOS
.DS_Store
